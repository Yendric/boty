{
    "name": "boty",
    "version": "1.0.0",
    "description": "Boty - Yendric discord bot",
    "author": "Yendric Van Roey",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Yendric/boty"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "generate": "prisma generate",
        "build": "npm run generate && tsc && tsc-alias",
        "start": "prisma migrate deploy && node ./dist/index.js",
        "dev": "npm run generate && tsx watch src/index.ts",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.15.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.4",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prisma": "^5.22.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.62.1"
    },
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.2",
        "@prisma/client": "^5.22.0",
        "discord.js": "^14.26.4",
        "ffmpeg-static": "^5.3.0",
        "ms": "^2.1.3",
        "opusscript": "^0.1.1",
        "youtubei.js": "^17.2.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@discordjs/opus",
            "@prisma/client",
            "@prisma/engines",
            "esbuild",
            "ffmpeg-static",
            "prisma"
        ]
    }
}
